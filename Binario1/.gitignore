# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/

# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/
Packages/

# CocoaPods / Carthage
Pods/
Carthage/Build/

# Local secrets / token overrides — NEVER commit these.
# DEBUG installed-device token: Config/Binario1Secrets.local.xcconfig (gitignored)
# is baked into the DEBUG build via Config/Binario1.debug.xcconfig. The committed
# Config/Binario1Secrets.example.xcconfig is a placeholder only.
*.local.swift
*.local.xcconfig
Config/*.local.xcconfig
*.secrets
*.env.local
.env.local

# Xcode SHARED scheme — can carry scheme environment variables (incl. a local
# BINARIO_BOARD_APP_TOKEN), so keep it out of git. Set the token in a per-user
# (non-"Shared") scheme so it lives in the already-ignored xcuserdata/ instead.
*.xcodeproj/xcshareddata/
