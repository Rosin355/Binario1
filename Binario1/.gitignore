# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/

# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/
Packages/

# CocoaPods / Carthage
Pods/
Carthage/Build/

# Local secrets / token overrides — NEVER commit these.
# (Preferred: set BINARIO_BOARD_APP_TOKEN in the Xcode scheme env vars, which live
# in the already-ignored xcuserdata/. These cover any file-based local override too.)
*.local.swift
*.local.xcconfig
*.secrets
*.env.local
.env.local

# Xcode SHARED scheme — can carry scheme environment variables (incl. a local
# BINARIO_BOARD_APP_TOKEN), so keep it out of git. Set the token in a per-user
# (non-"Shared") scheme so it lives in the already-ignored xcuserdata/ instead.
*.xcodeproj/xcshareddata/
